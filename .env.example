# Copie este arquivo para ".env" (copiar, nao mover).
#
# Voce precisa de UM provedor de IA. Ha dois caminhos, os dois de graca:
#
#   LOCAL   instale o Ollama e ligue LIVIA_OLLAMA=1 la embaixo. Nao precisa
#           de chave nenhuma e nada sai da sua maquina.
#   NUVEM   pegue uma chave gratuita do Gemini ou da Groq.
#
# Da para usar os dois: local primeiro, nuvem como reserva. E a configuracao
# padrao quando o Ollama esta ligado.

GEMINI_API_KEY=cole_sua_chave_aqui

# Seu nome (ela usa isso para se dirigir a você)
LIVIA_USER=André

# O nome dela. Troque à vontade — o título da página, o cabeçalho, o ícone da
# aba do navegador e o prompt se ajustam sozinhos ao que estiver aqui.
LIVIA_NAME=Livia

# Modelo principal (conversa).
# Os nomes do Gemini mudam com frequência e os antigos vão sendo desativados —
# se der erro 404, a mensagem no chat mostra o substituto que o Google indica.
# Evite os "-latest" e o gemini-3.7-flash: são modelos de raciocínio pesado e
# ficam lentos demais para conversa (chegaram a 90s por resposta em teste).
LIVIA_MODEL=gemini-3.6-flash

# Modelo barato e rápido, usado só para decidir o que memorizar.
LIVIA_FAST_MODEL=gemini-3.5-flash-lite

# --- Provedor reserva (fallback) ---------------------------------------
# Se o Gemini cair ou estourar a cota, a conversa continua aqui sozinha.
# Chave gratuita: https://console.groq.com/keys
GROQ_API_KEY=
LIVIA_GROQ_MODEL=openai/gpt-oss-120b
LIVIA_GROQ_FAST_MODEL=openai/gpt-oss-20b

# Ordem de tentativa. O `ollama` vem primeiro: quando esta ligado, e local,
# gratis e sem cota. Estando desligado, ele e simplesmente pulado, e a ordem
# efetiva vira groq -> gemini, como sempre foi.
#
# A Groq vem antes do Gemini porque responde em ~1,2s contra ~3,5s, publica
# quanto resta da cota em cabecalho, e o limite e folgado (1000/dia).
#
# Isso NAO custa a leitura de links: quando a mensagem tem uma URL, aquela
# chamada especifica vai para o Gemini, que e quem sabe abrir paginas.
LIVIA_PROVIDERS=ollama,groq,gemini,openrouter


# ========================================================================
# IA LOCAL (Ollama)
# ========================================================================
# O unico provedor sem chave, sem cota e sem nada saindo da maquina.
#
# Para usar:
#   1. instale em https://ollama.com
#   2. baixe os modelos:
#          ollama pull qwen3:8b
#          ollama pull qwen3:4b
#          ollama pull nomic-embed-text
#   3. ponha 1 aqui embaixo
#
# Desligado por padrao: ligar sem o servidor instalado so faria a Livia
# tentar uma conexao recusada antes de cair no provedor seguinte.
LIVIA_OLLAMA=0
LIVIA_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Nenhum modelo e obrigatorio. Estes sao sugestoes que rodam em maquina
# modesta; troque pelo que voce baixou.
LIVIA_OLLAMA_MODEL=qwen3:8b
LIVIA_OLLAMA_FAST_MODEL=qwen3:4b
LIVIA_OLLAMA_EMBED_MODEL=nomic-embed-text

# Ferramentas (ler e escrever arquivo, calcular) com o modelo local.
# Deixe 0 ate confirmar que o SEU modelo sabe chamar funcao: varios aceitam
# o parametro e ignoram, e a resposta sai dizendo que fez sem ter feito.
# Com 0, tarefas com ferramenta vao para a nuvem e o resto continua local.
LIVIA_OLLAMA_TOOLS=0

# Modelo local pensa devagar em maquina modesta. Segundos.
LIVIA_OLLAMA_TIMEOUT=300

# --- Modo totalmente local ----------------------------------------------
# Com 1, NENHUM servico externo e chamado: sem Gemini, sem Groq, sem
# OpenRouter, sem embeddings de nuvem. A web tambem nasce desligada (da
# para religar com LIVIA_WEB=1 de proposito).
LIVIA_LOCAL_ONLY=0

# --- Embeddings ----------------------------------------------------------
# Quem transforma texto em vetor. E isso que faz a busca por significado
# funcionar na memoria, nas licoes e na biblioteca.
#   ollama = so local | gemini = nuvem | auto = prefere o local
LIVIA_EMBED_PROVIDER=auto

# ========================================================================
# MEMORIA ADAPTATIVA
# ========================================================================
# Recuperacao semantica: em vez de despejar TODA a memoria em todo prompt,
# busca as que tem a ver com a pergunta. Com 0, volta ao comportamento
# antigo (tudo, ate estourar o orcamento).
LIVIA_SEMANTIC_MEMORY=1

# Quantos itens de cada tipo entram no prompt. Orcamento por TIPO, e nao
# so por total de caracteres: senao um documento grande engoliria a cota
# inteira e a memoria sumiria sem ninguem perceber.
LIVIA_MEMORY_MAX_ITEMS=8
LIVIA_EXPERIENCE_MAX_ITEMS=5
LIVIA_SKILL_MAX_ITEMS=4
LIVIA_LESSON_MAX_ITEMS=4
LIVIA_RAG_MAX_CHUNKS=5

# Acima disto, duas memorias falam da mesma coisa e viram uma so.
LIVIA_MEMORY_DUPLICATE=0.88
# Abaixo disto, a memoria nao tem a ver com a pergunta e fica de fora.
LIVIA_MEMORY_RELEVANCE=0.28

# --- Aprendizado por experiencia -----------------------------------------
# Registrar o que foi tentado e como terminou.
LIVIA_EXPERIENCE=1

# Quantas experiencias parecidas e concordantes ate virar heuristica.
# Uma so e anedota; virar regra a partir de um caso e aprender supersticao.
LIVIA_LEARNING_MIN_EXPERIENCES=3

# Skills que ela deduz de padroes ficam como CANDIDATAS esperando voce
# aprovar no painel. Ligar isto deixa ela promover sozinha — nao recomendado:
# uma skill entra em todo prompt futuro como procedimento a seguir.
LIVIA_SKILL_AUTO_APPROVE=0

# --- Busca na web --------------------------------------------------------
# ddg = DuckDuckGo (padrao) | searxng = instancia sua | auto = a sua, se houver
LIVIA_SEARCH_PROVIDER=ddg
LIVIA_SEARXNG_URL=


# ========================================================================
# CONHECIMENTO AVANCADO (grafo) — opcional, desligado por padrao
# ========================================================================
# A biblioteca acha TRECHO PARECIDO. Isso nao responde "que relacao existe
# entre X e Y" quando a resposta esta espalhada em documentos que nao se
# parecem entre si. O Knowledge Engine monta um grafo de entidades e
# relacoes e responde esse tipo de pergunta.
#
# Ele roda como SERVICO SEPARADO porque o motor (Cognee) traz 45
# dependencias obrigatorias. Instalar e rodar:
#
#     pip install -r requirements-knowledge.txt
#     python -m services.knowledge.run
#
# O QUE FAZ:     liga conceitos entre documentos
# PADRAO:        0 (desligado — a Livia funciona igual sem isto)
# QUANDO USAR:   quando voce tem varios documentos que se relacionam
# IMPACTO:       nenhum enquanto desligado; com ele ligado, perguntas
#                relacionais ficam melhores e custam ~1s a mais
LIVIA_KNOWLEDGE=0

# Endereco do servico. Precisa ser local: com LIVIA_LOCAL_ONLY=1 um
# endereco remoto e RECUSADO, porque documento nao pode sair da maquina.
LIVIA_KNOWLEDGE_URL=http://127.0.0.1:8110

# Teto para CONSULTAR o grafo durante uma resposta. Curto de proposito: o
# chat nao pode ficar esperando. Indexar e outra coisa e roda em fila.
# PADRAO: 4 segundos. Aumente se o seu grafo for grande e a maquina lenta.
LIVIA_KNOWLEDGE_TIMEOUT=4

# Quanto tempo o servico fica de castigo depois de falhar. Sem isto, cada
# mensagem pagaria uma conexao recusada antes de cair no RAG normal.
LIVIA_KNOWLEDGE_COOLDOWN=60

# Quanto conhecimento entra no prompt. Orcamento separado do RAG: melhor
# 4 evidencias de 4 fontes do que 10 trechos da mesma pagina.
LIVIA_KNOWLEDGE_MAX_RESULTS=6
LIVIA_KNOWLEDGE_MAX_CHARS=8000

# --- Modelos do grafo (INDEPENDENTES dos da Livia) ----------------------
# Extrair entidades depende muito de saida estruturada confiavel, e o
# modelo bom de conversa nao e necessariamente bom nisso. Mexer aqui NAO
# altera LIVIA_PROVIDERS nem LIVIA_OLLAMA_MODEL.
#
# ATENCAO: configure os DOIS. A documentacao do Cognee diz que, se voce
# configurar so o LLM, o embedding "defaults to OpenAI" — e ai o conteudo
# dos seus documentos vai para a nuvem sem aviso. O servico se recusa a
# subir se detectar isso com LIVIA_LOCAL_ONLY=1.
LIVIA_KNOWLEDGE_PROVIDER=ollama
LIVIA_KNOWLEDGE_LLM_MODEL=llama3.1:8b
LIVIA_KNOWLEDGE_LLM_ENDPOINT=http://127.0.0.1:11434/v1
LIVIA_KNOWLEDGE_EMBED_MODEL=nomic-embed-text
LIVIA_KNOWLEDGE_EMBED_ENDPOINT=http://127.0.0.1:11434

# Precisa bater com o modelo de embedding. nomic-embed-text = 768.
LIVIA_KNOWLEDGE_EMBED_DIM=768

# Onde o grafo e guardado. Em Docker, aponte para um volume persistente:
# reconstruir um grafo custa horas de CPU.
# LIVIA_KNOWLEDGE_DATA=/data/knowledge

# --- Parser avancado (documentos dificeis) ------------------------------
# O pypdf continua sendo o caminho rapido para PDF de texto. Isto so entra
# quando ele NAO consegue: PDF escaneado, tabela complexa, equacao.
#
# Exige o Knowledge Engine instalado mais:
#     pip install "raganything>=1.3"
#     pip install "raganything[paddleocr]"   # para OCR de escaneado
#
# PADRAO: 0. Sao gigabytes de dependencia — ligue so se precisar.
LIVIA_PARSER_AVANCADO=0

# Descrever imagem/diagrama com modelo de visao. Custa uma chamada por
# figura, e em LIVIA_LOCAL_ONLY=1 so funciona com modelo local.
LIVIA_PARSER_IMAGENS=0

# Quantas mensagens anteriores entram no contexto de cada resposta.
LIVIA_HISTORY_TURNS=20

# Aprendizado automático: 1 = liga, 0 = desliga (só memoriza com /lembrar).
LIVIA_AUTO_LEARN=1

# Limites de caracteres carregados por conversa (evita estourar contexto).
LIVIA_MEMORY_BUDGET=24000
LIVIA_SKILL_BUDGET=30000

# Onde o servidor sobe.
# 127.0.0.1 = so esta maquina. 0.0.0.0 = aceita de fora (exige senha).
LIVIA_HOST=127.0.0.1
LIVIA_PORT=8100

# --- Acesso -------------------------------------------------------------
# Senha para entrar. Vazio = sem protecao, e nesse caso o servidor SE RECUSA
# a subir com LIVIA_HOST=0.0.0.0. Obrigatoria para expor na internet.
LIVIA_PASSWORD=

# Marque 1 quando o acesso for por HTTPS (tunel ou hospedagem dao de graca).
# Faz o cookie de sessao nao trafegar em texto claro.
LIVIA_HTTPS=0

# Acesso a web: 1 = liga, 0 = desliga.
# Ler links usa a ferramenta nativa do Gemini (gratis). Buscar usa DuckDuckGo,
# porque a busca do Google (google_search) devolve 429 em conta gratuita.
LIVIA_WEB=1
LIVIA_WEB_RESULTS=5

# Deteccao automatica de "essa pergunta precisa da web?".
# Custa UMA chamada de API a mais por mensagem, o que pesa na cota gratuita.
# Com 0, a web so age quando voce pede: link colado ou /buscar.
LIVIA_WEB_AUTO=1

# --- Acesso de fora (servidor) ------------------------------------------
# Token do tunel do Cloudflare, se for expor pela internet.
# Crie em https://one.dash.cloudflare.com  (Zero Trust > Networks > Tunnels),
# aponte o tunel para  http://livia:8100  e cole o token aqui.
# Da um endereco HTTPS publico sem abrir porta nenhuma na maquina.
CLOUDFLARE_TUNNEL_TOKEN=

# Pasta dos dados. Em servidor, aponte para um disco que persista.
# LIVIA_DATA_DIR=/data

# --- Ferramentas --------------------------------------------------------
# Deixa a Livia listar, ler e escrever arquivos, e calcular. 1 = liga.
LIVIA_TOOLS=1

# A pasta onde ela pode mexer. TUDO fica confinado aqui: caminho para fora
# e recusado, inclusive com ../ ou caminho absoluto.
# Aponte para uma pasta de projeto se quiser que ela trabalhe nela, ciente
# de que podera sobrescrever arquivos la dentro. Toda sobrescrita guarda
# uma copia da versao anterior ao lado.
# LIVIA_WORKSPACE=C:\Users\anascimento\meus-projetos

# Quantas rodadas de ferramenta por resposta, no maximo.
LIVIA_TOOLS_ROUNDS=5

# --- Terceiro provedor: OpenRouter (opcional) ---------------------------
# So texto. Nao recebe ferramentas nem saida estruturada, de proposito: o
# modelo gratuito que ele escolhe varia e nem todos honram esses formatos.
# Sem esta chave, tudo continua funcionando como antes.
# Chave gratuita: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# `openrouter/free` e o roteador automatico deles: escolhe um modelo
# gratuito compativel a cada pedido. Medido em 2026-08-18: ~3s, caiu no
# Nemotron 3 Ultra, portugues correto.
# EVITE nvidia/nemotron-3-super-120b: vaza o raciocinio em ingles.
LIVIA_OPENROUTER_MODEL=openrouter/free
LIVIA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 0 desliga o provedor sem apagar a chave.
LIVIA_OPENROUTER=1

# Reservado. Ligar sem testar modelo a modelo da falha silenciosa: o modelo
# aceita o parametro e ignora a ferramenta.
LIVIA_OPENROUTER_TOOLS=0

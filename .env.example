# Copie este arquivo para ".env" (copiar, não mover) e preencha a chave.
# Pegue a chave gratuita em: https://aistudio.google.com/apikey

GEMINI_API_KEY=cole_sua_chave_aqui

# Seu nome (ela usa isso para se dirigir a você)
LIVIA_USER=André

# O nome dela. Troque à vontade — o título da página, o cabeçalho, o ícone da
# aba do navegador e o prompt se ajustam sozinhos ao que estiver aqui.
LIVIA_NAME=Livia

# Modelo principal (conversa).
# Os nomes do Gemini mudam com frequência e os antigos vão sendo desativados —
# se der erro 404, a mensagem no chat mostra o substituto que o Google indica.
# Evite os "-latest" e o gemini-3.7-flash: são modelos de raciocínio pesado e
# ficam lentos demais para conversa (chegaram a 90s por resposta em teste).
LIVIA_MODEL=gemini-3.6-flash

# Modelo barato e rápido, usado só para decidir o que memorizar.
LIVIA_FAST_MODEL=gemini-3.5-flash-lite

# --- Provedor reserva (fallback) ---------------------------------------
# Se o Gemini cair ou estourar a cota, a conversa continua aqui sozinha.
# Chave gratuita: https://console.groq.com/keys
GROQ_API_KEY=
LIVIA_GROQ_MODEL=openai/gpt-oss-120b
LIVIA_GROQ_FAST_MODEL=openai/gpt-oss-20b

# Ordem de tentativa. Groq primeiro: responde em ~1,2s contra ~3,5s do Gemini,
# publica quanto resta da cota em cabecalho, e o limite e folgado (1000/dia).
# Isso NAO custa a leitura de links: quando a mensagem tem uma URL, aquela
# chamada especifica vai para o Gemini, que e quem sabe abrir paginas.
LIVIA_PROVIDERS=groq,gemini

# Quantas mensagens anteriores entram no contexto de cada resposta.
LIVIA_HISTORY_TURNS=20

# Aprendizado automático: 1 = liga, 0 = desliga (só memoriza com /lembrar).
LIVIA_AUTO_LEARN=1

# Limites de caracteres carregados por conversa (evita estourar contexto).
LIVIA_MEMORY_BUDGET=24000
LIVIA_SKILL_BUDGET=30000

# Onde o servidor sobe.
# 127.0.0.1 = so esta maquina. 0.0.0.0 = aceita de fora (exige senha).
LIVIA_HOST=127.0.0.1
LIVIA_PORT=8100

# --- Acesso -------------------------------------------------------------
# Senha para entrar. Vazio = sem protecao, e nesse caso o servidor SE RECUSA
# a subir com LIVIA_HOST=0.0.0.0. Obrigatoria para expor na internet.
LIVIA_PASSWORD=

# Marque 1 quando o acesso for por HTTPS (tunel ou hospedagem dao de graca).
# Faz o cookie de sessao nao trafegar em texto claro.
LIVIA_HTTPS=0

# Acesso a web: 1 = liga, 0 = desliga.
# Ler links usa a ferramenta nativa do Gemini (gratis). Buscar usa DuckDuckGo,
# porque a busca do Google (google_search) devolve 429 em conta gratuita.
LIVIA_WEB=1
LIVIA_WEB_RESULTS=5

# Deteccao automatica de "essa pergunta precisa da web?".
# Custa UMA chamada de API a mais por mensagem, o que pesa na cota gratuita.
# Com 0, a web so age quando voce pede: link colado ou /buscar.
LIVIA_WEB_AUTO=1

# --- Acesso de fora (servidor) ------------------------------------------
# Token do tunel do Cloudflare, se for expor pela internet.
# Crie em https://one.dash.cloudflare.com  (Zero Trust > Networks > Tunnels),
# aponte o tunel para  http://livia:8100  e cole o token aqui.
# Da um endereco HTTPS publico sem abrir porta nenhuma na maquina.
CLOUDFLARE_TUNNEL_TOKEN=

# Pasta dos dados. Em servidor, aponte para um disco que persista.
# LIVIA_DATA_DIR=/data

# --- Ferramentas --------------------------------------------------------
# Deixa a Livia listar, ler e escrever arquivos, e calcular. 1 = liga.
LIVIA_TOOLS=1

# A pasta onde ela pode mexer. TUDO fica confinado aqui: caminho para fora
# e recusado, inclusive com ../ ou caminho absoluto.
# Aponte para uma pasta de projeto se quiser que ela trabalhe nela, ciente
# de que podera sobrescrever arquivos la dentro. Toda sobrescrita guarda
# uma copia da versao anterior ao lado.
# LIVIA_WORKSPACE=C:\Users\anascimento\meus-projetos

# Quantas rodadas de ferramenta por resposta, no maximo.
LIVIA_TOOLS_ROUNDS=5